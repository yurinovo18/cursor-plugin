    "postToolUseFailure": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" postToolUseFailure",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" beforeShellExecution",
