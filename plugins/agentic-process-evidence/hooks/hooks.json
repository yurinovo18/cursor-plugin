{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" sessionStart",
        "timeout": 15
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" sessionEnd",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" beforeSubmitPrompt",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" afterAgentResponse",
        "timeout": 15
      }
    ],
    "afterAgentThought": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" afterAgentThought",
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" preToolUse",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" postToolUse",
        "timeout": 30
      }
