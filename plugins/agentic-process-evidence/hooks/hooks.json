      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" subagentStart",
        "timeout": 15
      }
    ],
    "subagentStop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" subagentStop",
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" preCompact",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" stop",
        "timeout": 15
