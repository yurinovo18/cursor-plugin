    ],
    "afterShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" afterShellExecution",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" beforeMCPExecution",
        "timeout": 15
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/log_event.js\" afterMCPExecution",
        "timeout": 15
      }
